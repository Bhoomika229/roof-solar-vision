
# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (never commit raw/processed imagery or licensed datasets) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep
data/synthetic/

# --- Models / checkpoints (large binaries) ---
models/*.pt
models/*.pth
models/*.ckpt
!models/.gitkeep

# --- Results (regenerated by running the pipeline) ---
results/figures/*
!results/figures/.gitkeep
results/metrics/*
!results/metrics/.gitkeep
results/predictions/*
!results/predictions/.gitkeep

# --- Logs / experiment tracking ---
*.log
logs/
mlruns/
wandb/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Env / secrets ---
.env
*.env.local

# --- Streamlit ---
.streamlit/secrets.toml

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Notebook execution scratch (checkpoints only; executed .ipynb outputs are kept) ---
notebooks/.ipynb_checkpoints/
